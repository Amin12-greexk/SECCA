{
  "name": "secca",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter api dev",
    "api:dev": "pnpm --filter api dev",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "desktop:dev": "pnpm --filter desktop dev",
    "desktop:start": "pnpm --filter desktop start",
    "desktop:build": "pnpm --filter desktop build",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs db --tail=80",
    "prisma:migrate": "pnpm --filter api exec prisma migrate dev",
    "prisma:generate": "pnpm --filter api exec prisma generate",
    "prisma:studio": "pnpm --filter api exec prisma studio",
    "seed": "pnpm --filter api db:seed"
  }
}
