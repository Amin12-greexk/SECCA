generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LotStatus {
  AVAILABLE
  IN_PROGRESS
  COMPLETED
}

enum WorkOrderStatus {
  IN_PROGRESS
  COMPLETED
}

enum WorkOrderItemStatus {
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum WorkLane {
  NEXT_DAY
  IN_PROGRESS
  READY_TO_SUBMIT
}

enum MitraOrderRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  FULFILLED
}

enum RackType {
  PRE_SALE
  MITRA_ORDER
  FINISHED
  WORKER
}

enum MovementType {
  IN
  MOVE
  OUT
}

enum UserRole {
  BAKU
  MITRA
  KOREKSI
  MANAGER
  TRAINER
  ADMIN
}

enum GradeType {
  BULU
  WARNA
  BENTUK
}

enum AuditDashboardImportStatus {
  PENDING
  COMPLETED
  FAILED
}

enum RoomType {
  FACTORY
  MINIPLANT
}

model ProductionRoom {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  type      RoomType @default(FACTORY)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workers         Worker[]
  users           AppUser[]
  rackLocations   RackLocation[]
  pecahBonEntries PecahBonEntry[]
  lots            ProductionLot[]
}

model AppUser {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  phone             String?  @unique
  passwordHash      String
  role              UserRole
  workerId          String?  @unique
  productionRoomId  String?
  useCustomUiAccess Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productionRoom        ProductionRoom?        @relation(fields: [productionRoomId], references: [id], onDelete: SetNull)
  worker                Worker?                @relation("UserWorker", fields: [workerId], references: [id])
  supervisedWorkers     Worker[]               @relation("WorkerTrainer")
  mitraOrderRequests    MitraOrderRequest[]    @relation("MitraOrderRequester")
  mitraOrderProcessed   MitraOrderRequest[]    @relation("MitraOrderProcessor")
  uiAccesses            UserUiAccess[]
  auditDashboardImports AuditDashboardImport[] @relation("AuditDashboardUploader")
  auditMonthlyPeriods   AuditMonthlyPeriod[]   @relation("AuditMonthlyUploader")
  tariffAuditLogs       TariffAuditLog[]

  @@index([role])
}

model UserUiAccess {
  id        String   @id @default(uuid())
  userId    String
  moduleKey String
  level     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleKey])
  @@index([userId])
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  code      String?  @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rawBatches    RawBatch[]
  moistureRules MoistureRule[]
}

model Grade {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  type      GradeType @default(BULU)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shapeTariffs           GradeTariff[]        @relation("ShapeTariffs")
  featherTariffs         GradeTariff[]        @relation("FeatherTariffs")
  colorTariffs           GradeTariff[]        @relation("ColorTariffs")
  moistureRules          MoistureRule[]
  gradeStocks            RawBatchGradeStock[]
  lots                   ProductionLot[]
  featherLots            ProductionLot[]      @relation("LotFeatherGrade")
  colorLots              ProductionLot[]      @relation("LotColorGrade")
  payrolls               PayrollEntry[]
  pecahBonEntries        PecahBonEntry[]
  pecahBonFeatherEntries PecahBonEntry[]      @relation("PecahBonFeather")
  pecahBonColorEntries   PecahBonEntry[]      @relation("PecahBonColor")
}

model GradeTariff {
  id             String    @id @default(uuid())
  shapeGradeId   String
  featherGradeId String?
  colorGradeId   String?
  rateRpPerGram  Int
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  shapeGrade   Grade  @relation("ShapeTariffs", fields: [shapeGradeId], references: [id])
  featherGrade Grade? @relation("FeatherTariffs", fields: [featherGradeId], references: [id])
  colorGrade   Grade? @relation("ColorTariffs", fields: [colorGradeId], references: [id])

  @@index([shapeGradeId, featherGradeId, colorGradeId, effectiveFrom])
}

model MoistureRule {
  id            String    @id @default(uuid())
  gradeId       String?
  supplierId    String?
  moistureBps   Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  grade    Grade?    @relation(fields: [gradeId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([gradeId, supplierId, effectiveFrom])
}

model PecahBonPreset {
  id         String   @id @default(uuid())
  name       String
  weightGram Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BarangJadi {
  id            String   @id @default(uuid())
  name          String   @unique
  byProductKeys String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  byProducts     BarangJadiByProduct[]
  resultGrades   BarangJadiResultGrade[]
  finishReceipts FinishReceipt[]
}

model ByProductType {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barangJadis BarangJadiByProduct[]
  tariffs     ByProductTariff[]
}

model BarangJadiByProduct {
  barangJadiId    String
  byProductTypeId String
  createdAt       DateTime @default(now())

  barangJadi    BarangJadi    @relation(fields: [barangJadiId], references: [id], onDelete: Cascade)
  byProductType ByProductType @relation(fields: [byProductTypeId], references: [id], onDelete: Restrict)

  @@id([barangJadiId, byProductTypeId])
  @@index([byProductTypeId])
}

model BarangJadiGradeType {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barangJadis    BarangJadiResultGrade[]
  finishReceipts FinishReceiptResultGrade[]
  tariffs        ResultGradeTariff[]
}

model BarangJadiResultGrade {
  barangJadiId      String
  resultGradeTypeId String
  createdAt         DateTime @default(now())

  barangJadi      BarangJadi          @relation(fields: [barangJadiId], references: [id], onDelete: Cascade)
  resultGradeType BarangJadiGradeType @relation(fields: [resultGradeTypeId], references: [id], onDelete: Restrict)

  @@id([barangJadiId, resultGradeTypeId])
  @@index([resultGradeTypeId])
}

model ResultGradeTariff {
  id                String    @id @default(uuid())
  resultGradeTypeId String
  rateRpPerGram     Int
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  resultGradeType BarangJadiGradeType @relation(fields: [resultGradeTypeId], references: [id], onDelete: Cascade)

  @@index([resultGradeTypeId, effectiveFrom])
}

model ByProductTariff {
  id              String    @id @default(uuid())
  byProductTypeId String
  rateRpPerGram   Int
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  byProductType ByProductType @relation(fields: [byProductTypeId], references: [id], onDelete: Cascade)

  @@index([byProductTypeId, effectiveFrom])
}

model TariffAuditLog {
  id                    String   @id @default(uuid())
  tariffType            String
  tariffId              String
  action                String
  previousRateRpPerGram Int?
  newRateRpPerGram      Int?
  changedByUserId       String
  changedAt             DateTime @default(now())
  metadata              Json?

  changedBy AppUser @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([tariffType, tariffId, changedAt])
  @@index([changedByUserId, changedAt])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RackLocation {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  type             RackType
  workerId         String?
  productionRoomId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  productionRoom ProductionRoom?     @relation(fields: [productionRoomId], references: [id], onDelete: SetNull)
  worker         Worker?             @relation(fields: [workerId], references: [id])
  lots           ProductionLot[]
  movementsFrom  InventoryMovement[] @relation("MovementFrom")
  movementsTo    InventoryMovement[] @relation("MovementTo")

  @@unique([workerId])
  @@unique([productionRoomId, type])
  @@index([productionRoomId])
}

model Worker {
  id               String   @id @default(uuid())
  name             String
  code             String?  @unique
  pin              String?  @unique
  capacityGram     Int?
  isMiniplant      Boolean  @default(false)
  trainerId        String?
  productionRoomId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  productionRoom        ProductionRoom?        @relation(fields: [productionRoomId], references: [id], onDelete: SetNull)
  user                  AppUser?               @relation("UserWorker")
  rackLocation          RackLocation?
  workOrders            WorkOrder[]
  payrolls              PayrollEntry[]
  activeWorkOrder       WorkerActiveWorkOrder?
  trainer               AppUser?               @relation("WorkerTrainer", fields: [trainerId], references: [id])
  mitraOrderRequests    MitraOrderRequest[]
  auditDashboardPersons AuditDashboardPerson[] @relation("AuditDashboardPersonWorker")

  @@index([trainerId])
  @@index([productionRoomId])
}

model MitraOrderRequest {
  id                String                  @id @default(uuid())
  workerId          String?
  requestedByUserId String
  parentRequestId   String?
  requestedGram     Int
  note              String?
  status            MitraOrderRequestStatus @default(REQUESTED)
  rejectionReason   String?
  processedByUserId String?
  processedAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  worker        Worker?                 @relation(fields: [workerId], references: [id], onDelete: SetNull)
  requestedBy   AppUser                 @relation("MitraOrderRequester", fields: [requestedByUserId], references: [id])
  processedBy   AppUser?                @relation("MitraOrderProcessor", fields: [processedByUserId], references: [id])
  parentRequest MitraOrderRequest?      @relation("TrainerSubRequests", fields: [parentRequestId], references: [id], onDelete: SetNull)
  subRequests   MitraOrderRequest[]     @relation("TrainerSubRequests")
  lines         MitraOrderRequestLine[]

  @@index([workerId, status, createdAt])
  @@index([requestedByUserId, createdAt])
  @@index([parentRequestId, status, createdAt])
}

model MitraOrderRequestLine {
  id             String   @id @default(uuid())
  orderRequestId String
  sequence       Int
  weightGram     Int
  lpCount        Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderRequest MitraOrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  workItems    WorkOrderItem[]

  @@unique([orderRequestId, sequence])
  @@index([orderRequestId, sequence])
}

model NumberSequence {
  id        String   @id @default(uuid())
  key       String   @unique
  current   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RawBatch {
  id                   String    @id @default(uuid())
  batchNumber          String    @unique
  cardId               String    @unique
  supplierId           String
  mergedIntoRawBatchId String?
  mergedAt             DateTime?
  featherCondition     String
  invoiceWeightGram    Float
  wetWeightGram        Float
  moisturePercent      Float
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  supplier               Supplier             @relation(fields: [supplierId], references: [id])
  mergedIntoRawBatch     RawBatch?            @relation("RawBatchMerge", fields: [mergedIntoRawBatchId], references: [id])
  mergedSourceRawBatches RawBatch[]           @relation("RawBatchMerge")
  gradeStocks            RawBatchGradeStock[]
  pecahBonEntries        PecahBonEntry[]

  @@index([supplierId, createdAt])
  @@index([mergedIntoRawBatchId])
}

model PecahBonEntry {
  id                String   @id @default(uuid())
  pecahBonId        String?  @unique
  rawBatchId        String
  gradeId           String
  featherGradeId    String?
  colorGradeId      String?
  orderedByName     String?
  orderedForName    String?
  productionRoomId  String?
  pecahBonDate      DateTime
  featherCondition  String
  pieceCount        Int
  initialWeightGram Float
  moisturePercent   Float
  dryWeightGram     Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productionRoom ProductionRoom? @relation(fields: [productionRoomId], references: [id], onDelete: SetNull)
  rawBatch       RawBatch        @relation(fields: [rawBatchId], references: [id])
  grade          Grade           @relation(fields: [gradeId], references: [id])
  featherGrade   Grade?          @relation("PecahBonFeather", fields: [featherGradeId], references: [id])
  colorGrade     Grade?          @relation("PecahBonColor", fields: [colorGradeId], references: [id])

  @@index([rawBatchId, createdAt])
  @@index([pecahBonDate])
  @@index([productionRoomId])
}

model RawBatchGradeStock {
  id                     String   @id @default(uuid())
  rawBatchId             String
  gradeId                String
  wetWeightGram          Int
  remainingWetWeightGram Int
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  rawBatch   RawBatch    @relation(fields: [rawBatchId], references: [id])
  grade      Grade       @relation(fields: [gradeId], references: [id])
  lotSources LotSource[]

  @@unique([rawBatchId, gradeId])
}

model ProductionLot {
  id                  String    @id @default(uuid())
  lotNumber           String    @unique
  externalId          String?   @unique
  gradeId             String
  featherGradeId      String?
  colorGradeId        String?
  wetWeightGram       Int
  dryWeightGramLocked Int
  moistureBps         Int
  status              LotStatus
  locationId          String
  productionRoomId    String?
  printedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  productionRoom ProductionRoom?     @relation(fields: [productionRoomId], references: [id], onDelete: SetNull)
  grade          Grade               @relation(fields: [gradeId], references: [id])
  featherGrade   Grade?              @relation("LotFeatherGrade", fields: [featherGradeId], references: [id])
  colorGrade     Grade?              @relation("LotColorGrade", fields: [colorGradeId], references: [id])
  location       RackLocation        @relation(fields: [locationId], references: [id])
  sources        LotSource[]
  // One-to-many karena lot yang pernah di-cancel menyimpan baris CANCELED
  // sebagai riwayat. Yang aktif dijamin maksimal satu oleh partial unique
  // index (lihat WorkOrderItem.lotId) — pakai helper activeWorkItem() di
  // common/inventory/active-work-item.ts untuk mengambilnya.
  workItems      WorkOrderItem[]
  movements      InventoryMovement[]

  @@index([locationId, createdAt])
  @@index([locationId, printedAt])
  @@index([locationId, gradeId, createdAt])
  @@index([productionRoomId])
}

model LotSource {
  id            String   @id @default(uuid())
  lotId         String
  gradedStockId String
  wetWeightGram Int
  createdAt     DateTime @default(now())

  lot         ProductionLot      @relation(fields: [lotId], references: [id])
  gradedStock RawBatchGradeStock @relation(fields: [gradedStockId], references: [id])

  @@index([gradedStockId])
}

model WorkOrder {
  id          String          @id @default(uuid())
  workerId    String
  status      WorkOrderStatus @default(IN_PROGRESS)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  completedAt DateTime?

  worker       Worker                 @relation(fields: [workerId], references: [id])
  items        WorkOrderItem[]
  activeRecord WorkerActiveWorkOrder?
}

model WorkOrderItem {
  id                      String              @id @default(uuid())
  workOrderId             String
  // Sengaja BUKAN @unique penuh. Satu lot boleh punya banyak baris sepanjang
  // hanya satu yang aktif: baris CANCELED harus tetap tersimpan sebagai riwayat,
  // tapi tidak boleh menghalangi lot itu di-assign ulang. Keunikan "satu item
  // aktif per lot" dijaga partial unique index di migration
  // 20260818000000_work_order_item_lot_unique_active (Prisma belum bisa
  // mendeklarasikan partial unique index).
  lotId                   String
  mitraOrderRequestLineId String?
  status                  WorkOrderItemStatus @default(IN_PROGRESS)
  lane                    WorkLane            @default(IN_PROGRESS)
  startedAt               DateTime?
  readyAt                 DateTime?
  dryingStartedAt         DateTime?
  dryingReadyAt           DateTime?
  dryCheckedAt            DateTime?
  canceledAt              DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  workOrder             WorkOrder              @relation(fields: [workOrderId], references: [id])
  lot                   ProductionLot          @relation(fields: [lotId], references: [id])
  mitraOrderRequestLine MitraOrderRequestLine? @relation(fields: [mitraOrderRequestLineId], references: [id], onDelete: SetNull)
  finishReceipt         FinishReceipt?
  payrollEntry          PayrollEntry?

  @@index([dryingReadyAt])
  @@index([mitraOrderRequestLineId])
  @@index([lotId])
}

model WorkerActiveWorkOrder {
  id          String   @id @default(uuid())
  workerId    String   @unique
  workOrderId String   @unique
  createdAt   DateTime @default(now())

  worker    Worker    @relation(fields: [workerId], references: [id])
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
}

model FinishReceipt {
  id                  String   @id @default(uuid())
  workOrderItemId     String   @unique
  barangJadiId        String?
  returnedAt          DateTime
  mainOutWeightGram   Int
  byProductWeightGram Int
  dryInGram           Int
  susutProsesGram     Int
  susutHilangGram     Int
  susutProsesPctBps   Int
  susutHilangPctBps   Int
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  barangJadi    BarangJadi?                @relation(fields: [barangJadiId], references: [id])
  workOrderItem WorkOrderItem              @relation(fields: [workOrderItemId], references: [id])
  resultGrades  FinishReceiptResultGrade[]

  @@index([barangJadiId])
}

model FinishReceiptResultGrade {
  id                String   @id @default(uuid())
  finishReceiptId   String
  resultGradeTypeId String
  weightGram        Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  finishReceipt   FinishReceipt       @relation(fields: [finishReceiptId], references: [id], onDelete: Cascade)
  resultGradeType BarangJadiGradeType @relation(fields: [resultGradeTypeId], references: [id], onDelete: Restrict)

  @@unique([finishReceiptId, resultGradeTypeId])
  @@index([resultGradeTypeId])
}

model PayrollEntry {
  id              String   @id @default(uuid())
  workOrderItemId String   @unique
  workerId        String
  gradeId         String
  rateRpPerGram   Int
  amountRp        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workOrderItem WorkOrderItem @relation(fields: [workOrderItemId], references: [id])
  worker        Worker        @relation(fields: [workerId], references: [id])
  grade         Grade         @relation(fields: [gradeId], references: [id])
}

/// Dashboard performa berbasis upload Excel manual.
/// Terpisah penuh dari tabel produksi (RawBatch, ProductionLot, dst) —
/// nilai Excel adalah source of truth dan tidak pernah dipakai lintas modul.
/// Format Excel-nya sama persis, tapi file-nya beda: PERFORMA untuk dashboard
/// /performa, PEMBAYARAN untuk yang dilihat mitra di portal /cek (gaji, riwayat
/// pembayaran, barang jadi). Keduanya di-upload terpisah & tidak saling timpa.
enum AuditDashboardDataset {
  PERFORMA
  PEMBAYARAN
}

model AuditDashboardImport {
  id               String                     @id @default(uuid())
  fileName         String
  fileHash         String?
  uploadedByUserId String?
  status           AuditDashboardImportStatus @default(PENDING)
  dataset          AuditDashboardDataset      @default(PERFORMA)
  totalSheets      Int                        @default(0)
  totalRows        Int                        @default(0)
  errorJson        Json?
  warnings         Json?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  uploadedBy AppUser?               @relation("AuditDashboardUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  periods    AuditDashboardPeriod[]

  @@index([uploadedByUserId])
  @@index([createdAt])
}

model AuditDashboardPeriod {
  id                       String    @id @default(uuid())
  importId                 String
  /// Data mana periode ini milik: dashboard performa atau portal /cek.
  dataset                  AuditDashboardDataset @default(PERFORMA)
  sheetName                String
  label                    String
  startDate                DateTime?
  endDate                  DateTime?
  year                     Int?
  sortOrder                Int       @default(0)
  /// BJD reprocess (gram) yang pekerjanya tidak punya baris di REKAP PAYROLL
  /// periode ini, jadi tidak bisa ditempel ke metric siapa pun. Tetap ikut
  /// Total BJD supaya angkanya sama dengan Excel.
  unassignedReprocessBjd   Float?
  unassignedReprocessCount Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  import     AuditDashboardImport      @relation(fields: [importId], references: [id], onDelete: Cascade)
  metrics    AuditDashboardMetric[]
  harianRows AuditDashboardHarianRow[]

  @@index([importId])
  @@index([dataset, sortOrder, createdAt])
}

model AuditDashboardPerson {
  id             String   @id @default(uuid())
  name           String
  normalizedName String   @unique
  workerId       String?
  colorHex       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  worker  Worker?                @relation("AuditDashboardPersonWorker", fields: [workerId], references: [id], onDelete: SetNull)
  metrics AuditDashboardMetric[]

  @@index([workerId])
}

model AuditDashboardMetric {
  id                String   @id @default(uuid())
  periodId          String
  personId          String
  rawName           String
  rawUserLevel      String?
  normalizedLevel   String?
  levelNumber       Int?
  hk                Float?
  totalBakuBasah    Float?
  totalBjd          Float?
  rendemenPctBps    Int?
  susutProsesPctBps Int?
  susutHilangPctBps Int?
  pieceworkWageRp   Float?
  subsidyRp         Float?
  premiumRp         Float?
  mealAllowanceRp   Float?
  deductionRp       Float?
  netWageRp         Float?
  rawRowJson        Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  period AuditDashboardPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  person AuditDashboardPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([periodId, personId])
  @@index([personId, createdAt])
  @@index([periodId])
}

/// PIN login portal mitra (/cek): mitra cek performa & gajinya sendiri cukup
/// dengan PIN, tanpa akun & tanpa nama. Diisi dari file PIN perusahaan yang
/// di-upload manager (diganti total tiap upload) — bukan dari kolom PIN di
/// Excel performa, karena di sana satu PIN bisa dipakai beberapa orang.
/// Dicocokkan ke AuditDashboardPerson lewat normalizedName (+ alias opsional)
/// saat login, jadi periode yang di-upload belakangan otomatis ikut.
model MitraPortalPin {
  id             String   @id @default(uuid())
  name           String
  normalizedName String   @unique
  /// Nama lain di Excel performa (sudah dinormalisasi), mis. nama pendek.
  aliases        String[] @default([])
  /// HMAC-SHA256 PIN (hex) dengan rahasia server — PIN tidak disimpan polos,
  /// tapi tetap bisa dicari langsung karena login hanya memakai PIN. Unik:
  /// satu PIN = satu orang. Null = baris lama sebelum login PIN-saja, harus
  /// upload ulang file PIN supaya bisa dipakai masuk.
  pinKey         String?  @unique
  /// Password buatan mitra sendiri (scrypt "salt:hash" hex). Kalau terisi, PIN
  /// tidak lagi dipakai masuk; login lewat nama lengkap + password.
  passwordHash   String?
  /// Kapan password terakhir dibuat/diganti. Ikut di token sesi: ganti atau
  /// reset password membuat semua sesi lama tidak berlaku.
  passwordSetAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/**
 * Pekerja "Anak Harian" (staf pendukung pabrik dibayar harian: Cleaning Service,
 * QC, Trainer, dst) — tabel terpisah dari mitra bulu (AuditDashboardPerson) karena
 * populasi, PIN, dan skema gajinya sama sekali beda (tidak ada Baku Basah/BJD/
 * Rendemen/Kapasitas). Muncul di sheet REKAP PAYROLL sebagai tabel ketiga yang
 * berdampingan dengan tabel mitra borong/bulanan, lihat audit-dashboard.parser.ts.
 */
model AuditDashboardHarianPerson {
  id             String   @id @default(uuid())
  name           String
  normalizedName String   @unique
  pin            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rows AuditDashboardHarianRow[]

  @@index([pin])
}

model AuditDashboardHarianRow {
  id                  String   @id @default(uuid())
  periodId            String
  personId            String
  pin                 String?
  rawName             String
  bagian              String?
  gapokRp             Float?
  /**
   * Teks asli kolom "Hari Kerja" — formatnya tidak konsisten antar periode
   * (kadang "6/6", kadang angka polos), jadi disimpan mentah + hasil parsing-nya.
   */
  hariKerjaRaw        String?
  hariKerja           Float?
  upahRp              Float?
  upahLemburWeekdayRp Float?
  upahLemburWeekendRp Float?
  uangMakanRp         Float?
  premiRp             Float?
  tunjanganRp         Float?
  potonganRp          Float?
  totalUpahRp         Float?
  rawRowJson          Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  period AuditDashboardPeriod       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  person AuditDashboardHarianPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([periodId, personId])
  @@index([personId, createdAt])
  @@index([periodId])
}

/// Dashboard audit bulanan — terpisah dari AuditDashboard* (mingguan/per-mitra).
/// Menyimpan total perusahaan per bulan (Total Baku Basah, Total BJD, Rendemen)
/// dari sheet "LAPORAN BULANAN" (1 sheet = 1 bulan), plus rincian per mitra
/// (AuditMonthlyPersonMetric) — tanpa payroll sama sekali. Lihat
/// audit-monthly.parser.ts.
model AuditMonthlyPeriod {
  id                     String   @id @default(uuid())
  year                   Int
  month                  Int
  label                  String
  sheetName              String
  totalBakuBasah         Float
  totalBjd               Float
  weightedRendemenPctBps Int?
  totalRows              Int      @default(0)
  /**
   * Baris berbobot yang NAMA-nya tidak terbaca (mis. VLOOKUP #N/A) —
   * sudah ikut totalBakuBasah/totalBjd di atas tapi tidak ada di
   * personMetrics manapun. Lihat komentar di audit-monthly.parser.ts.
   */
  unattributedRows       Int      @default(0)
  unattributedBjd        Float    @default(0)
  sourceFileName         String
  uploadedByUserId       String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  uploadedBy    AppUser?                   @relation("AuditMonthlyUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  personMetrics AuditMonthlyPersonMetric[]

  @@unique([year, month])
  @@index([year, month])
}

/// Rincian per mitra dalam satu bulan — dikelompokkan HANYA berdasarkan kolom
/// NAMA (bukan NO. LP): baris tanpa NO. LP "resmi" (mis. kode batch seperti
/// "TEI-2503-26") tetap ikut terhitung ke kapasitas orang itu selama kolom
/// NAMA & bobotnya terisi, konsisten dengan cara totalBakuBasah/totalBjd di
/// AuditMonthlyPeriod dijumlah (tidak pernah menyaring lewat NO. LP).
model AuditMonthlyPersonMetric {
  id                     String   @id @default(uuid())
  periodId               String
  rawName                String
  normalizedName         String
  totalBakuBasah         Float
  totalBjd               Float
  weightedRendemenPctBps Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  period AuditMonthlyPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, normalizedName])
  @@index([periodId])
}

model InventoryMovement {
  id             String       @id @default(uuid())
  lotId          String
  fromLocationId String?
  toLocationId   String
  movementType   MovementType
  note           String?
  createdAt      DateTime     @default(now())

  lot          ProductionLot @relation(fields: [lotId], references: [id])
  fromLocation RackLocation? @relation("MovementFrom", fields: [fromLocationId], references: [id])
  toLocation   RackLocation  @relation("MovementTo", fields: [toLocationId], references: [id])

  @@index([lotId, createdAt])
}
