generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LotStatus {
  AVAILABLE
  IN_PROGRESS
  COMPLETED
}

enum WorkOrderStatus {
  IN_PROGRESS
  COMPLETED
}

enum WorkOrderItemStatus {
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum WorkLane {
  NEXT_DAY
  IN_PROGRESS
  READY_TO_SUBMIT
}

enum MitraOrderRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  FULFILLED
}

enum RackType {
  PRE_SALE
  MITRA_ORDER
  FINISHED
  WORKER
}

enum MovementType {
  IN
  MOVE
  OUT
}

enum UserRole {
  BAKU
  MITRA
  KOREKSI
  MANAGER
  TRAINER
}

enum GradeType {
  BULU
  WARNA
  BENTUK
}

model AppUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole
  workerId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  worker            Worker? @relation("UserWorker", fields: [workerId], references: [id])
  supervisedWorkers Worker[] @relation("WorkerTrainer")
  mitraOrderRequests MitraOrderRequest[] @relation("MitraOrderRequester")
  mitraOrderProcessed MitraOrderRequest[] @relation("MitraOrderProcessor")

  @@index([role])
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  code      String?  @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rawBatches    RawBatch[]
  moistureRules MoistureRule[]
}

model Grade {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  type      GradeType @default(BULU)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shapeTariffs    GradeTariff[] @relation("ShapeTariffs")
  featherTariffs  GradeTariff[] @relation("FeatherTariffs")
  colorTariffs    GradeTariff[] @relation("ColorTariffs")
  moistureRules   MoistureRule[]
  gradeStocks     RawBatchGradeStock[]
  lots            ProductionLot[]
  featherLots     ProductionLot[] @relation("LotFeatherGrade")
  colorLots       ProductionLot[] @relation("LotColorGrade")
  payrolls        PayrollEntry[]
  pecahBonEntries PecahBonEntry[]
  pecahBonFeatherEntries PecahBonEntry[] @relation("PecahBonFeather")
  pecahBonColorEntries   PecahBonEntry[] @relation("PecahBonColor")
}

model GradeTariff {
  id              String   @id @default(uuid())
  shapeGradeId    String
  featherGradeId  String?
  colorGradeId    String?
  rateRpPerGram   Int
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shapeGrade   Grade  @relation("ShapeTariffs", fields: [shapeGradeId], references: [id])
  featherGrade Grade? @relation("FeatherTariffs", fields: [featherGradeId], references: [id])
  colorGrade   Grade? @relation("ColorTariffs", fields: [colorGradeId], references: [id])

  @@index([shapeGradeId, featherGradeId, colorGradeId, effectiveFrom])
}

model MoistureRule {
  id            String   @id @default(uuid())
  gradeId       String?
  supplierId    String?
  moistureBps   Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  grade    Grade?    @relation(fields: [gradeId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([gradeId, supplierId, effectiveFrom])
}

model PecahBonPreset {
  id        String   @id @default(uuid())
  name      String
  weightGram Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RackLocation {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  type      RackType
  workerId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  worker         Worker?              @relation(fields: [workerId], references: [id])
  lots           ProductionLot[]
  movementsFrom  InventoryMovement[]  @relation("MovementFrom")
  movementsTo    InventoryMovement[]  @relation("MovementTo")

  @@unique([workerId])
}

model Worker {
  id        String   @id @default(uuid())
  name      String
  code      String?  @unique
  pin       String?  @unique
  capacityGram Int?
  trainerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         AppUser? @relation("UserWorker")
  rackLocation  RackLocation?
  workOrders    WorkOrder[]
  payrolls      PayrollEntry[]
  activeWorkOrder WorkerActiveWorkOrder?
  trainer      AppUser? @relation("WorkerTrainer", fields: [trainerId], references: [id])
  mitraOrderRequests MitraOrderRequest[]

  @@index([trainerId])
}

model MitraOrderRequest {
  id                String                  @id @default(uuid())
  workerId          String?
  requestedByUserId String
  requestedGram     Int
  note              String?
  status            MitraOrderRequestStatus @default(REQUESTED)
  rejectionReason   String?
  processedByUserId String?
  processedAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  worker      Worker?  @relation(fields: [workerId], references: [id], onDelete: SetNull)
  requestedBy AppUser  @relation("MitraOrderRequester", fields: [requestedByUserId], references: [id])
  processedBy AppUser? @relation("MitraOrderProcessor", fields: [processedByUserId], references: [id])
  lines       MitraOrderRequestLine[]

  @@index([workerId, status, createdAt])
  @@index([requestedByUserId, createdAt])
}

model MitraOrderRequestLine {
  id             String   @id @default(uuid())
  orderRequestId String
  sequence       Int
  weightGram     Int
  lpCount        Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderRequest MitraOrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)

  @@index([orderRequestId, sequence])
  @@unique([orderRequestId, sequence])
}

model NumberSequence {
  id        String   @id @default(uuid())
  key       String   @unique
  current   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RawBatch {
  id               String   @id @default(uuid())
  batchNumber      String   @unique
  cardId           String   @unique
  supplierId       String
  mergedIntoRawBatchId String?
  mergedAt         DateTime?
  featherCondition String
  invoiceWeightGram Float
  wetWeightGram    Float
  moisturePercent  Float
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  supplier       Supplier             @relation(fields: [supplierId], references: [id])
  mergedIntoRawBatch RawBatch?        @relation("RawBatchMerge", fields: [mergedIntoRawBatchId], references: [id])
  mergedSourceRawBatches RawBatch[]   @relation("RawBatchMerge")
  gradeStocks    RawBatchGradeStock[]
  pecahBonEntries PecahBonEntry[]

  @@index([supplierId, createdAt])
  @@index([mergedIntoRawBatchId])
}

model PecahBonEntry {
  id                String   @id @default(uuid())
  pecahBonId        String?  @unique
  rawBatchId        String
  gradeId           String
  featherGradeId    String?
  colorGradeId      String?
  pecahBonDate      DateTime
  featherCondition  String
  pieceCount        Int
  initialWeightGram Float
  moisturePercent   Float
  dryWeightGram     Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  rawBatch     RawBatch @relation(fields: [rawBatchId], references: [id])
  grade        Grade    @relation(fields: [gradeId], references: [id])
  featherGrade Grade?   @relation("PecahBonFeather", fields: [featherGradeId], references: [id])
  colorGrade   Grade?   @relation("PecahBonColor", fields: [colorGradeId], references: [id])

  @@index([rawBatchId, createdAt])
  @@index([pecahBonDate])
}

model RawBatchGradeStock {
  id                     String   @id @default(uuid())
  rawBatchId             String
  gradeId                String
  wetWeightGram          Int
  remainingWetWeightGram Int
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  rawBatch   RawBatch    @relation(fields: [rawBatchId], references: [id])
  grade      Grade       @relation(fields: [gradeId], references: [id])
  lotSources LotSource[]

  @@unique([rawBatchId, gradeId])
}

model ProductionLot {
  id                 String    @id @default(uuid())
  lotNumber          String    @unique
  externalId         String?
  gradeId            String
  featherGradeId     String?
  colorGradeId       String?
  wetWeightGram      Int
  dryWeightGramLocked Int
  moistureBps        Int
  status             LotStatus
  locationId         String
  printedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  grade        Grade        @relation(fields: [gradeId], references: [id])
  featherGrade Grade?       @relation("LotFeatherGrade", fields: [featherGradeId], references: [id])
  colorGrade   Grade?       @relation("LotColorGrade", fields: [colorGradeId], references: [id])
  location     RackLocation @relation(fields: [locationId], references: [id])
  sources    LotSource[]
  workItem   WorkOrderItem?
  movements  InventoryMovement[]

  @@index([locationId, createdAt])
  @@index([locationId, printedAt])
  @@index([locationId, gradeId, createdAt])
}

model LotSource {
  id            String   @id @default(uuid())
  lotId         String
  gradedStockId String
  wetWeightGram Int
  createdAt     DateTime @default(now())

  lot         ProductionLot      @relation(fields: [lotId], references: [id])
  gradedStock RawBatchGradeStock @relation(fields: [gradedStockId], references: [id])

  @@index([gradedStockId])
}

model WorkOrder {
  id          String          @id @default(uuid())
  workerId    String
  status      WorkOrderStatus @default(IN_PROGRESS)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  completedAt DateTime?

  worker Worker          @relation(fields: [workerId], references: [id])
  items  WorkOrderItem[]
  activeRecord WorkerActiveWorkOrder?
}

model WorkOrderItem {
  id          String               @id @default(uuid())
  workOrderId String
  lotId       String               @unique
  status      WorkOrderItemStatus  @default(IN_PROGRESS)
  lane        WorkLane             @default(IN_PROGRESS)
  startedAt   DateTime?
  readyAt     DateTime?
  canceledAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  workOrder     WorkOrder     @relation(fields: [workOrderId], references: [id])
  lot           ProductionLot @relation(fields: [lotId], references: [id])
  finishReceipt FinishReceipt?
  payrollEntry  PayrollEntry?
}

model WorkerActiveWorkOrder {
  id          String   @id @default(uuid())
  workerId    String   @unique
  workOrderId String   @unique
  createdAt   DateTime @default(now())

  worker    Worker    @relation(fields: [workerId], references: [id])
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
}

model FinishReceipt {
  id                String   @id @default(uuid())
  workOrderItemId   String   @unique
  returnedAt        DateTime
  mainOutWeightGram Int
  byProductWeightGram Int
  dryInGram         Int
  susutProsesGram   Int
  susutHilangGram   Int
  susutProsesPctBps Int
  susutHilangPctBps Int
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workOrderItem WorkOrderItem @relation(fields: [workOrderItemId], references: [id])
}

model PayrollEntry {
  id              String   @id @default(uuid())
  workOrderItemId String   @unique
  workerId        String
  gradeId         String
  rateRpPerGram   Int
  amountRp        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workOrderItem WorkOrderItem @relation(fields: [workOrderItemId], references: [id])
  worker        Worker        @relation(fields: [workerId], references: [id])
  grade         Grade         @relation(fields: [gradeId], references: [id])
}

model InventoryMovement {
  id             String        @id @default(uuid())
  lotId          String
  fromLocationId String?
  toLocationId   String
  movementType   MovementType
  note           String?
  createdAt      DateTime      @default(now())

  lot          ProductionLot @relation(fields: [lotId], references: [id])
  fromLocation RackLocation? @relation("MovementFrom", fields: [fromLocationId], references: [id])
  toLocation   RackLocation  @relation("MovementTo", fields: [toLocationId], references: [id])

  @@index([lotId, createdAt])
}
