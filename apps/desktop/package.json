{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "description": "SECCA desktop wrapper",
  "author": "SECCA",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "electron-secure-pos-printer": "^1.1.4"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.secca.desktop",
    "productName": "SECCA",
    "files": [
      "**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
